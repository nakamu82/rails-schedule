<table class="table table-striped"> 
  <thead> 
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>編集</th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.id %></td>
        <td><%= link_to post.title, "/posts/#{post.id}" %></td>
        <td><%= post.start_time.strftime("%Y/%m/%d") if post.start_time.present? %></td>
        <td><%= post.end_time.strftime("%Y/%m/%d") if post.end_time.present? %></td>
        <td><%= post.all_day? ? "〇" : "" %></td>
        <td><%= post.created_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td>
          <%= link_to "編集", "/posts/#{post.id}/edit", class: "btn btn-success me-2" %>
          <%= link_to "削除", "/posts/#{post.id}", method: :delete, data: {confirm: "予定を削除しますか？"}, class: "btn btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>予定合計 <%= @posts.count %> 件</p>
<%= link_to "⊕新規追加", "/posts/new", class: "btn btn-primary" %>

