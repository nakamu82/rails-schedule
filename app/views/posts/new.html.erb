<%= render "shared/error", obj: @post %>


<%= form_with model: @post, local: true do |f| %>
  <div class="card" style="width:24rem;">
    <h5 class="card-title">スケジュールを登録しましょう！</h5>

    <p class="card-text">タイトル</p>
    <textarea name="post[title]"></textarea>


    <label class="form-label">開始日</label> 
    <%= f.date_field:start_time,class: "form-control" %>

    <label class="form-label">終了日</label>
    <%= f.date_field:end_time, class: "form-control" %>

    <div class="form-check">
      <%= check_box_tag "post[all_day]","1", class: "form-check-input", id: "all_day" %>
      <%= label_tag "all_day", "終日", class: "form-check-label" %>
    </div>

    <p class="card-text">スケジュールメモ</p>
    <textarea name="post[content]"></textarea>

    <div class="mt-3">
      <input type="submit" value="登録" class="btn btn-success">
    </div>

  </div>
<% end %>

