<%= form_tag("/posts/#{@post.id}", method: :patch) do %>

  <div class="card" style="width:24rem;">
    <h5 class="card-title">スケジュールを編集しましょう。</h5>
    <p class="card-text">タイトル</p>
    <textarea name="post[title]"><%= @post.title %></textarea>

    <label for="start_time" class="form-label">開始日</label> 
    <%= date_field_tag "post[start_time]", @post.start_time, class: "form-control" %>
    <label for="end_time" class="form-label">終了日</label>
    <%= date_field_tag "post[end_time]", @post.end_time, class: "form-control" %>   

    <div class="form-check">
      <%= check_box_tag "post[all_day]", "1", class: "form-check-input", id: "all_day" %>
      <%= label_tag "all_day", "終日", class: "form-check-label" %>
    </div>

    <p class="card-text">スケジュールメモ</p>
    <textarea name="post[content]"><%= @post.content %></textarea>

    <div class="mt-3">
      <input type="submit" value="登録" class="btn btn-success">
      <%= link_to "削除", post_path(@post), method: :delete, data: {confirm:  "予定を削除しますか？"}, class: "btn btn-danger" %>
    </div>
  </div>
<% end %>